.venv/
__pycache__/
*.pyc

# Secrets
.env
.env.local

# Runtime / user output — app re-creates on first run. `data/` is the legacy
# name (pre-2026-07-09 rename to match Comfy's `output/` convention).
data/
output/

# Local dev tooling / IDE
.claude/

# External tools installed by the app at runtime (AnimoFlow etc.) — cloned
# fresh via /api/motion/install on user machines, don't commit the vendored copy.
# Use tools/* (not tools/) so git still descends into the folder and the
# negations below can re-include child subtrees we author ourselves.
tools/*
# TripoSplat is our own Dockerfile + FastAPI wrapper around the upstream
# repo, so it ships in-repo and gets built by the user's local
# `docker compose up`.
!tools/triposplat/
!tools/triposplat/**

# Early-stage prototype HTMLs — kept locally for reference but not shipped.
mockups/

# Personal onboarding-emulator wrapper — used locally to re-test the first-run
# flow (?firstrun=1 clears the "seen" flag). Not something to distribute.
firstrun.bat
