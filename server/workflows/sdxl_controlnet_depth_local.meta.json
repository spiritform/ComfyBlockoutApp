{
  "id": "sdxl_controlnet_depth_local",
  "label": "SDXL ControlNet",
  "kind": "image",
  "output_ext": "png",
  "runner": "local",
  "inputs": [
    {
      "name": "image",
      "type": "scene-image",
      "label": "Viewport / Source Image",
      "patch": {
        "node_id": 10,
        "widget_index": 0,
        "widget_name": "image"
      }
    },
    {
      "name": "checkpoint",
      "type": "dropdown",
      "label": "Checkpoint",
      "options_source": {
        "class_type": "CheckpointLoaderSimple",
        "widget": "ckpt_name",
        "include": "xl"
      },
      "default": "SDXL\\Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors",
      "patch": {
        "node_id": 1,
        "widget_name": "ckpt_name"
      }
    },
    {
      "name": "preprocessor",
      "type": "dropdown",
      "label": "Preprocessor",
      "default": "DepthAnythingV2Preprocessor",
      "options": [
        "none",
        "AnimeFace_SemSegPreprocessor",
        "AnyLineArtPreprocessor_aux",
        "BinaryPreprocessor",
        "CannyEdgePreprocessor",
        "ColorPreprocessor",
        "DensePosePreprocessor",
        "DepthAnythingPreprocessor",
        "Zoe_DepthAnythingPreprocessor",
        "DepthAnythingV2Preprocessor",
        "DSINE-NormalMapPreprocessor",
        "DWPreprocessor",
        "AnimalPosePreprocessor",
        "HEDPreprocessor",
        "FakeScribblePreprocessor",
        "LeReS-DepthMapPreprocessor",
        "LineArtPreprocessor",
        "AnimeLineArtPreprocessor",
        "LineartStandardPreprocessor",
        "Manga2Anime_LineArt_Preprocessor",
        "MediaPipe-FaceMeshPreprocessor",
        "MeshGraphormer-DepthMapPreprocessor",
        "Metric3D-DepthMapPreprocessor",
        "Metric3D-NormalMapPreprocessor",
        "MiDaS-NormalMapPreprocessor",
        "MiDaS-DepthMapPreprocessor",
        "M-LSDPreprocessor",
        "BAE-NormalMapPreprocessor",
        "OneFormer-COCO-SemSegPreprocessor",
        "OneFormer-ADE20K-SemSegPreprocessor",
        "OpenposePreprocessor",
        "PiDiNetPreprocessor",
        "PyraCannyPreprocessor",
        "ImageLuminanceDetector",
        "ScribblePreprocessor",
        "Scribble_PiDiNet_Preprocessor",
        "TEEDPreprocessor",
        "TilePreprocessor",
        "Zoe-DepthMapPreprocessor",
        "SAMPreprocessor",
        "ShufflePreprocessor",
        "ImageIntensityDetector",
        "Scribble_XDoG_Preprocessor",
        "TTPlanet_TileGF_Preprocessor",
        "TTPlanet_TileSimple_Preprocessor"
      ],
      "patch": {
        "node_id": 9,
        "widget_index": 0,
        "widget_name": "preprocessor"
      }
    },
    {
      "name": "preproc_blur",
      "type": "number",
      "label": "Preproc Blur",
      "default": 17,
      "min": 0,
      "max": 31,
      "step": 1,
      "patch": {
        "node_id": 22,
        "widget_name": "blur_radius"
      }
    },
    {
      "name": "preproc_sigma",
      "type": "number",
      "label": "Preproc Sigma",
      "default": 3.8,
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "patch": {
        "node_id": 22,
        "widget_name": "sigma"
      }
    },
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Positive Prompt",
      "placeholder": "a cozy living room, warm lighting, photorealistic, highly detailed",
      "required": true,
      "patch": {
        "node_id": 6,
        "widget_index": 0,
        "widget_name": "text"
      }
    },
    {
      "name": "negative_prompt",
      "type": "textarea",
      "label": "Negative Prompt",
      "placeholder": "blurry, lowres, jpeg artifacts, watermark, ugly",
      "patch": {
        "node_id": 7,
        "widget_index": 0,
        "widget_name": "text"
      }
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed",
      "patch": {
        "node_id": 3,
        "widget_index": 0,
        "widget_name": "seed"
      }
    },
    {
      "name": "sampler",
      "type": "dropdown",
      "label": "Sampler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "sampler_name"
      },
      "default": "dpmpp_2m",
      "patch": {
        "node_id": 3,
        "widget_name": "sampler_name"
      }
    },
    {
      "name": "scheduler",
      "type": "dropdown",
      "label": "Scheduler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "scheduler"
      },
      "default": "karras",
      "patch": {
        "node_id": 3,
        "widget_name": "scheduler"
      }
    },
    {
      "name": "steps",
      "type": "number",
      "label": "Steps",
      "default": 30,
      "min": 1,
      "max": 150,
      "step": 1,
      "patch": {
        "node_id": 3,
        "widget_name": "steps"
      }
    },
    {
      "name": "cfg",
      "type": "number",
      "label": "CFG",
      "default": 7,
      "min": 0,
      "max": 30,
      "step": 0.5,
      "patch": {
        "node_id": 3,
        "widget_name": "cfg"
      }
    },
    {
      "name": "controlnet_strength",
      "type": "number",
      "label": "ControlNet",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "patch": {
        "node_id": 16,
        "widget_index": 0,
        "widget_name": "strength"
      }
    }
  ],
  "intermediates": [
    {
      "name": "preproc",
      "label": "Preproc",
      "source_node_id": 22,
      "source_slot": 0,
      "filename_prefix": "sdxl_cn_preproc"
    }
  ]
}
