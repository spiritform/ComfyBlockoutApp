{
  "id": "flux2_klein_i2i_local",
  "label": "Flux 2 Klein · Local",
  "kind": "image",
  "output_ext": "png",
  "runner": "local",
  "inputs": [
    {
      "name": "image",
      "type": "scene-image",
      "label": "Viewport / Source Image",
      "patch": {
        "node_id": 10,
        "widget_index": 0,
        "widget_name": "image"
      }
    },
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "placeholder": "Describe the transformation \u2014 e.g. 'photorealistic dusk lighting, cinematic'",
      "required": true,
      "patch": {
        "node_id": 4,
        "widget_index": 0,
        "widget_name": "text"
      }
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed",
      "patch": {
        "node_id": 7,
        "widget_name": "seed"
      }
    },
    {
      "name": "sampler",
      "type": "dropdown",
      "label": "Sampler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "sampler_name"
      },
      "default": "euler",
      "patch": {
        "node_id": 7,
        "widget_name": "sampler_name"
      }
    },
    {
      "name": "scheduler",
      "type": "dropdown",
      "label": "Scheduler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "scheduler"
      },
      "default": "simple",
      "patch": {
        "node_id": 7,
        "widget_name": "scheduler"
      }
    },
    {
      "name": "steps",
      "type": "number",
      "label": "Steps",
      "row": "sc",
      "default": 20,
      "min": 1,
      "max": 50,
      "step": 1,
      "patch": {
        "node_id": 7,
        "widget_name": "steps"
      }
    },
    {
      "name": "guidance",
      "type": "number",
      "label": "Guidance",
      "row": "sc",
      "default": 3.5,
      "min": 1,
      "max": 10,
      "step": 0.5,
      "patch": {
        "node_id": 5,
        "widget_name": "guidance"
      }
    },
    {
      "name": "denoise",
      "type": "number",
      "label": "Denoise",
      "default": 0.75,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "patch": {
        "node_id": 7,
        "widget_name": "denoise"
      }
    }
  ]
}
