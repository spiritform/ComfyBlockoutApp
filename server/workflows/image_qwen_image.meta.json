{
  "id": "image_qwen_image",
  "label": "Qwen Image \u00b7 Local",
  "kind": "image",
  "output_ext": "png",
  "runner": "local",
  "inputs": [
    {
      "name": "image",
      "type": "scene-image",
      "label": "Viewport / Source Image",
      "patch": {
        "node_id": 107,
        "widget_index": 0,
        "widget_name": "image"
      }
    },
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Positive Prompt",
      "placeholder": "a cinematic establishing shot at dusk, warm amber lantern light, photorealistic, highly detailed",
      "required": true,
      "patch": {
        "node_id": 93,
        "widget_index": 0,
        "widget_name": "text"
      }
    },
    {
      "name": "negative_prompt",
      "type": "textarea",
      "label": "Negative Prompt",
      "placeholder": "blurry, lowres, jpeg artifacts, watermark, ugly",
      "patch": {
        "node_id": 94,
        "widget_index": 0,
        "widget_name": "text"
      }
    },
    {
      "name": "seed",
      "type": "seed",
      "label": "Seed",
      "patch": {
        "node_id": 97,
        "widget_name": "seed"
      }
    },
    {
      "name": "sampler",
      "type": "dropdown",
      "label": "Sampler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "sampler_name"
      },
      "default": "euler",
      "patch": {
        "node_id": 97,
        "widget_name": "sampler_name"
      }
    },
    {
      "name": "scheduler",
      "type": "dropdown",
      "label": "Scheduler",
      "options_source": {
        "class_type": "KSampler",
        "widget": "scheduler"
      },
      "default": "simple",
      "patch": {
        "node_id": 97,
        "widget_name": "scheduler"
      }
    },
    {
      "name": "steps",
      "type": "number",
      "label": "Steps",
      "row": "sc",
      "default": 8,
      "min": 1,
      "max": 50,
      "step": 1,
      "patch": {
        "node_id": 97,
        "widget_name": "steps"
      }
    },
    {
      "name": "cfg",
      "type": "number",
      "label": "CFG",
      "row": "sc",
      "default": 1,
      "min": 0,
      "max": 20,
      "step": 0.5,
      "patch": {
        "node_id": 97,
        "widget_name": "cfg"
      }
    },
    {
      "name": "shift",
      "type": "number",
      "label": "Shift",
      "default": 3.1,
      "min": 0.5,
      "max": 10,
      "step": 0.1,
      "patch": {
        "node_id": 91,
        "widget_name": "shift"
      }
    },
    {
      "name": "denoise",
      "type": "number",
      "label": "Denoise",
      "default": 0.75,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "patch": {
        "node_id": 97,
        "widget_name": "denoise"
      }
    },
    {
      "name": "lora",
      "type": "dropdown",
      "label": "LoRA",
      "options_source": {
        "class_type": "LoraLoaderModelOnly",
        "widget": "lora_name"
      },
      "default": "qwen\\flymy_realism.safetensors",
      "patch": {
        "node_id": 109,
        "widget_name": "lora_name"
      }
    },
    {
      "name": "lightning",
      "type": "dropdown",
      "label": "Lightning",
      "options": ["Off", "4-step", "8-step"],
      "default": "4-step",
      "patch": [
        {
          "node_id": 96,
          "widget_name": "lora_name",
          "value_map": {
            "Off": "Qwen-Image-Lightning-4steps-V1.0.safetensors",
            "4-step": "Qwen-Image-Lightning-4steps-V1.0.safetensors",
            "8-step": "Qwen-Image-Lightning-8steps-V1.0.safetensors"
          }
        },
        {
          "node_id": 96,
          "widget_name": "strength_model",
          "value_map": {
            "Off": 0.0,
            "4-step": 1.0,
            "8-step": 1.0
          }
        }
      ]
    }
  ]
}
